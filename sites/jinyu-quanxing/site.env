# ══════════════════════════════════════════════════════════════════════
#  晉瑜全興案場參數（現場確認後調整）
#  被 lib/common.sh 自動載入，所有腳本皆可使用
# ══════════════════════════════════════════════════════════════════════

SITE_NAME="jinyu-quanxing"

# ── EMS HA（keepalived + haproxy，照 evergreen-yp 模式）──
VIP="192.168.100.100"            # keepalived 虛擬 IP
BACKEND_PORT="8888"              # haproxy 後端（EMS web）port
KEEPALIVED_AUTH_PASS="10149683"  # VRRP 驗證密碼（最長 8 碼），兩台會渲染成一致，現場可改
KEEPALIVED_VRID="101"            # virtual_router_id：同一網段內必須唯一（實測曾撞到別組 HA）
HAPROXY_PPA_VERSION=""           # 留空 = 用發行版內建版本；填 "2.7" 走 ppa:vbernat/haproxy-2.7
                                 # （過往筆記在 Ubuntu 20.04 用 PPA 裝 2.7）

# ── NAS / Samba ──
NAS_SHARE_NAME="storage"
NAS_SHARE_PATH="/mnt/nas/storage"   # NAS 機上的 share 實體路徑
NAS_MOUNT_POINT="/mnt/nas/storage"  # 其他機器的 cifs 掛載點
NAS_SMB_USER="myuser"
NAS_SMB_PASSWORD=""              # 現場填入（留空則腳本執行時互動詢問）
                                 # ⚠ 若填入真實密碼，commit 前務必清空

# ── MongoDB（原生安裝在 mongo 主機上，非 docker）──
MONGO_VERSION="8.0"              # mongodb-org 版本，裝最新穩定版（8.0）
MONGO_BIND_IP=""                 # 留空 = 自動用「127.0.0.1,mongo主機內網IP」（照筆記做法，不開 0.0.0.0）

# ── NTP（container，四台都裝）──
NTP_SERVERS="tock.stdtime.gov.tw,watch.stdtime.gov.tw,time.google.com"
                                 # chrony 上游來源（台灣國家標準時間 + Google 備援）
                                 # 案場無對外網路時仍可對 LAN 提供一致時間

# ── 其他 ──
SITE_TIMEZONE="Asia/Taipei"
