location /api/ {
    proxy_pass          http://web-api:5000/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/getUserPlugin {
        proxy_pass http://192.168.100.104:9000/api/getUserPlugin;
    }

    sub_filter '/api/getUserPlugin' '/tjs/api/getUserPlugin';
    sub_filter_once off;
}
