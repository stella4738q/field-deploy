location /tjs/ {
    proxy_pass          http://192.168.100.104:9000/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    sub_filter 'http://192.168.100.104:9000/' '/tjs/';
    sub_filter_once off;
}

location /tjs/product/ {
    proxy_pass          http://192.168.100.104:9000/product/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /tjs/static/ {
    proxy_pass          http://192.168.100.104:9000/static/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /static/ {
    proxy_pass          http://192.168.100.104:9000/static/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /tjs/api/ {
    proxy_pass          http://192.168.100.104:9000/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /tjs/socket {
    proxy_pass          http://192.168.100.100:8009;
    proxy_http_version  1.1;
    proxy_set_header    Upgrade $http_upgrade;                                                                              proxy_set_header    Connection "upgrade";
} 

location /tjs/node_modules/ {
    proxy_pass          http://192.168.100.104:9000/node_modules/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /node_modules/ {
    proxy_pass          http://192.168.100.104:9000/node_modules/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
