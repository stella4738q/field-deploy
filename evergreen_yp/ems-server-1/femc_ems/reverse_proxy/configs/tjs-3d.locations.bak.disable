location /tjs/ {
    proxy_pass          http://192.168.100.104:9000/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /tjs/product/ {
        proxy_pass http://192.168.100.104:9000/product/;
    }

    location /tjs/static/ {
        proxy_pass http://192.168.100.104:9000/static/;
    }

    location /tjs/api/ {
        proxy_pass http://192.168.100.104:9000/api/;
    }

    sub_filter 'http://192.168.100.104:9000/' '/tjs/';
    sub_filter_once off;
}

location /static/r/DIY/panel/ {
    proxy_pass          http://192.168.100.104:9000/tjs/static/r/DIY/panel/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /static/ {
    proxy_pass          http://192.168.100.104:9000/static/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
